#!/bin/bash

help='''Undoes the changes that are automatically made to the source files when
multiple special modules are used. See target special_preps in Makefile.src.

Example usage:
    pc_restore_special special/chiral_mhd.f90

Options:
    -h,--help               Show this help
    -r,--root               Path to simulation directory. If this is passed,
                            make the changes in this directory instead of in
                            $PENCIL_HOME. Useful if you have special modules
                            in your local simulation directory that are not
                            checked in to the main repository
'''

if test -z "$PENCIL_HOME"; then
    echo "\$PENCIL_HOME must be set to use this script"
    exit 1
fi

# BEGIN option parsing
#https://stackoverflow.com/questions/192249/how-do-i-parse-command-line-arguments-in-bash/29754866#29754866
set -o errexit -o pipefail -o noclobber -o nounset

LONGOPTS=root:,help
OPTIONS=r:h

PARSED=$(getopt --options=$OPTIONS --longoptions=$LONGOPTS --name "$0" -- "$@") || exit 2
eval set -- "$PARSED"

root="$PENCIL_HOME"
while true; do
    case "$1" in
        -r|--root)
            root="$2"
            shift 2
            ;;
        -h|--help)
            echo "$help"
            exit 0
            ;;
        --)
            shift
            break
            ;;
        *)
            echo "Error in parsing options"
            exit 3
            ;;
    esac
done
# END option parsing

if test "$#" -lt 1; then
    echo "pc_restore_special: no files were specified"
    exit 5
fi

for file in $1; do
    sed -e '/module  *procedure/ ! s/^\( *module  *\)[a-zA-Z0-9_]* */\1Special/' \
        -e 's/^\( *endmodule  *\)[a-zA-Z0-9_]* *$/\1Special/' \
        -e 's/[a-zA-Z0-9_]*\.inc/special_dummies.inc/' \
        -e 's/namelist *\/[a-zA-Z0-9_]*[a-zA-Z0-9]_\([ir][a-z]*_pars\)/namelist \/special_\1/' \
        -e 's/NML *= *[a-zA-Z0-9_]*_\([a-z][a-z]*_pars\)/NML=special_\1/' $file > $file.tmp

    dest="$root/src/$file"
    if test -L "$dest"; then
        dest="$(readlink -f "$dest")"
    elif ! test -f "$dest"; then
        echo "Trying to replace file \'$dest\' which does not exist"
        exit 4
    fi

    if ! cmp -s special.tmp $(SPECIAL_MODULES).f90; then
        mv -f "$file.tmp" "$dest"
    else
        rm "$file.tmp"
    fi
done
