##  -*-Makefile-*- (for Emacs)    vim:set filetype=make:  (for vim)
##
##  $Id$
##
##  Makefile dependencies for modular Pencil Code.
##
#
#  Non-F90 / undetectable dependencies.
#
debug.o: debug_c.c headers_c.h
#
nodebug.o: nodebug.f90 $(CDATA_OBJ) quiet.o
#
#  KT flux-limited transport (Higgsless): explicit deps so the dummy/real module
#  never races ahead of its base modules under parallel make.
#
kt_transport.o: kt_transport.f90 $(CDATA_OBJ) $(CPARAM_OBJ) quiet.o
#
nokt_transport.o: nokt_transport.f90 $(CPARAM_OBJ) quiet.o
#
io_dist.o: io_dist.h
#
# Explicit dependencies for the different infrastructure modules.
#
quiet.o: quiet.f90 $(CPARAM_OBJ)
#
no%.o: no%.f90 %.h quiet.o
#
$(CPARAM_OBJ): $(CPARAM_SRC) cparam.local cparam.inc cparam_enum.h
#
$(CDATA_OBJ): $(CDATA_SRC) $(CPARAM_OBJ)
#
ifneq ($(GRID),nogrid)
$(GRID_OBJ): $(GRID_SRC) $(CDATA_OBJ) $(IO_OBJ) $(MPICOMM_OBJ) $(MESSAGES_OBJ) $(SUB_OBJ)
endif
#
$(MORTON_HELPER_OBJ): $(MORTON_HELPER_SRC)
#
$(GENERAL_OBJ): $(GENERAL_SRC) $(CPARAM_OBJ) $(CDATA_OBJ) $(SYSCALLS_OBJ) $(MORTON_HELPER_OBJ) $(PTHREAD_OBJ) quiet.o
#
ifneq ($(SHOCK),noshock)
$(SHOCK_OBJ): shock.h $(SHOCK_SRC) $(CDATA_OBJ) $(SUB_OBJ) $(BOUNDCOND_OBJ) $(FARRAY_OBJ) $(MAGNETIC_OBJ)
else
noshock.o: shock.h noshock.f90 quiet.o $(MESSAGES_OBJ)
endif
#
$(DIAGNOSTICS_OBJ): $(DIAGNOSTICS_SRC) $(CDATA_OBJ) $(CPARAM_OBJ) $(FILE_IO_OBJ) $(IO_OBJ) $(HDF5_IO_OBJ) $(GENERAL_OBJ) $(MESSAGES_OBJ) $(MPICOMM_OBJ) $(SUB_OBJ) $(YINYANG_MPI_OBJ)
#
$(SHARED_MEM_OBJ): $(SHARED_MEM_SRC)
#
ifneq ($(FARRAY_ALLOC),nofarray_alloc)
$(FARRAY_ALLOC_OBJ): $(FARRAY_ALLOC_SRC) $(CDATA_OBJ) $(MESSAGES_OBJ) $(SHARED_MEM_OBJ)
else
$(FARRAY_ALLOC_OBJ): $(FARRAY_ALLOC_SRC) $(MESSAGES_OBJ)
endif
#
$(FILE_IO_OBJ): file_io.h file_io_common.inc $(FILE_IO_SRC) $(CDATA_OBJ) $(CPARAM_OBJ) $(GENERAL_OBJ) $(MESSAGES_OBJ) $(MPICOMM_OBJ) $(SYSCALLS_OBJ) syscalls_ansi.o
#
ifneq ($(LORENZ_GAUGE),nolorenz_gauge)
$(LORENZ_GAUGE_OBJ): lorenz_gauge.h $(LORENZ_GAUGE_SRC) $(CDATA_OBJ) $(QUIET_OBJ) $(MESSAGES_OBJ) $(FARRAY_OBJ) $(INITCOND_OBJ) $(MPICOMM_OBJ) $(SUB_OBJ) $(DIAGNOSTICS_OBJ) $(FILE_IO_OBJ) $(SLICES_METHODS_OBJ)
endif
#
implicit_diffusion.o: implicit_diffusion.h implicit_diffusion.f90 $(BOUNDCOND_OBJ) $(CPARAM_OBJ) $(CDATA_OBJ) $(FOURIER_OBJ) $(GENERAL_OBJ) $(MESSAGES_OBJ) $(MPICOMM_OBJ) $(SHEAR_OBJ)
#
ifneq ($(IMPLICIT_PHYSICS),noimplicit_physics)
$(IMPLICIT_PHYSICS_OBJ): implicit_physics.h $(IMPLICIT_PHYSICS_SRC) $(CDATA_OBJ) $(GENERAL_OBJ) $(MESSAGES_OBJ) $(SUB_OBJ) $(ENERGY_OBJ) $(EOS_OBJ) $(FARRAY_OBJ) $(GRAVITY_OBJ) $(BOUNDCOND_OBJ) $(SHARED_VARIABLES_OBJ)
endif
#
ifneq ($(DERIV),noderiv)
$(DERIV_OBJ): $(DERIV_SRC) $(CDATA_OBJ) $(MESSAGES_OBJ) $(MPICOMM_OBJ)
endif
#
$(FARRAY_OBJ): $(FARRAY_SRC) $(CDATA_OBJ) $(MESSAGES_OBJ) $(GENERAL_OBJ) $(HDF5_IO_OBJ)
#
$(SHARED_VARIABLES_OBJ): $(SHARED_VARIABLES_SRC) $(MESSAGES_OBJ) $(GENERAL_OBJ)
#
ifneq ($(BORDER_PROFILES),noborder_profiles)
$(BORDER_PROFILES_OBJ): $(BORDER_PROFILES_SRC) $(CDATA_OBJ) $(SHARED_VARIABLES_OBJ) $(SUB_OBJ) $(IO_OBJ)
else
$(BORDER_PROFILES_OBJ): $(BORDER_PROFILES_SRC) $(MESSAGES_OBJ) quiet.o
endif
#
ifneq ($(SLICES),noslices)
$(SLICES_OBJ): $(SLICES_SRC) $(CDATA_OBJ) $(CHEMISTRY_OBJ) $(CHIRAL_OBJ)  $(COSMICRAY_OBJ) $(DENSITY_OBJ) $(DUSTDENSITY_OBJ) $(DUSTVELOCITY_OBJ) $(ENERGY_OBJ) $(EOS_OBJ) $(GENERAL_OBJ) $(HEATFLUX_OBJ) $(HYDRO_OBJ) $(IO_OBJ) $(INTERSTELLAR_OBJ) $(MAGNETIC_OBJ) $(MESSAGES_OBJ) $(MPICOMM_OBJ) $(PARTICLES_MAIN_OBJ) $(PSCALAR_OBJ) $(RADIATION_OBJ) $(SHOCK_OBJ) $(SLICES_METHODS_OBJ) $(SPECIAL_OBJ) $(SUB_OBJ) $(TESTFIELD_OBJ) $(TESTFLOW_OBJ) $(TESTSCALAR_OBJ)
endif
#
$(SLICES_METHODS_OBJ): $(SLICES_METHODS_SRC) $(CDATA_OBJ) $(GENERAL_OBJ) $(MESSAGES_OBJ)
#
$(SUB_OBJ): $(GPU_OBJ) $(SUB_SRC) $(CDATA_OBJ) $(DERIV_OBJ) $(FARRAY_OBJ) $(GENERAL_OBJ) $(GEOMETRICAL_TYPES_OBJ) $(HDF5_IO_OBJ) $(FILE_IO_OBJ) $(MESSAGES_OBJ) $(MPICOMM_OBJ) $(YINYANG_MPI_OBJ)
#
$(PARAM_IO_OBJ): $(PARAM_IO_SRC) $(CDATA_OBJ) $(FILE_IO_OBJ) $(MPICOMM_OBJ) $(SUB_OBJ) $(TIMESTEP_OBJ) $(TIMEAVG_OBJ) $(physics) $(IO_OBJ) $(PARTICLES_MAIN_OBJ) $(PYTHON_OBJ) $(TESTPERTURB_OBJ) $(TRAINING_OBJ) $(SIGNAL_HANDLING_OBJ) $(STREAMLINES_OBJ)
#
$(REGISTER_OBJ): $(OMP_PREREQ) $(REGISTER_SRC) $(CDATA_OBJ) $(FARRAY_OBJ) $(MPICOMM_OBJ) $(SUB_OBJ) $(IO_OBJ) $(physics) $(TIMEAVG_OBJ) $(DIAGNOSTICS_OBJ) $(EQU_OBJ) $(GPU_OBJ) $(GRID_OBJ) $(TESTPERTURB_OBJ) $(SOLID_CELLS_OBJ) $(DIAGNOSTICS_OBJ) $(PARAM_IO_OBJ) $(POWER_OBJ) $(TRAINING_OBJ)
#
$(EQU_OBJ): $(EQU_SRC) $(CDATA_OBJ) $(MPICOMM_OBJ) $(GHOSTFOLD_OBJ) $(GPU_OBJ) $(MESSAGES_OBJ) $(SUB_OBJ) $(physics) $(BOUNDCOND_OBJ) $(POISSON_OBJ) $(PARTICLES_MAIN_OBJ) $(INTERSTELLAR_OBJ) $(GRID_OBJ) $(SNAPSHOT_OBJ) $(FORCING_OBJ) $(SOLID_CELLS_OBJ) $(SLICES_OBJ) $(NSCBC_OBJ) $(DIAGNOSTICS_OBJ) $(HEATFLUX_OBJ) $(TRAINING_OBJ)
#
$(PENCIL_CHECK_OBJ): $(PENCIL_CHECK_SRC) $(EQU_OBJ) $(MPICOMM_OBJ) $(MESSAGES_OBJ) $(GENERAL_OBJ) $(SUB_OBJ)
#
ifneq ($(BOUNDCOND),noboundcond)
$(BOUNDCOND_OBJ): $(BOUNDCOND_SRC) $(CDATA_OBJ) $(CPARAM_OBJ) $(DERIV_OBJ) $(EOS_OBJ) $(GENERAL_OBJ) $(GRID_OBJ) $(FARRAY_OBJ) $(FILE_IO_OBJ) $(FOURIER_OBJ) $(MESSAGES_OBJ) $(MPICOMM_OBJ) $(SHEAR_OBJ) $(SPECIAL_OBJ) $(MAGNETIC_MEANFIELD_OBJ) fourier_common.h
endif
#
$(INITCOND_OBJ): $(INITCOND_SRC) $(CDATA_OBJ) $(EOS_OBJ) $(FARRAY_OBJ) $(FOURIER_OBJ) $(GENERAL_OBJ) $(GRAVITY_OBJ) $(IO_OBJ) $(MESSAGES_OBJ) $(MPICOMM_OBJ) $(SUB_OBJ)
#
ifeq ($(INITIAL_CONDITION),noinitial_condition)
  $(INITIAL_CONDITION_OBJ): initial_condition.h $(INITIAL_CONDITION_SRC) $(MESSAGES_OBJ) quiet.o
else ifeq ($(shell grep -i '^ *use  *particles_cdata' $(INITIAL_CONDITION_SRC)),)
  $(INITIAL_CONDITION_OBJ): initial_condition.h $(INITIAL_CONDITION_SRC) initial_condition_dummies.inc $(COMMON_DEPS) $(FARRAY_OBJ) $(GENERAL_OBJ) $(POISSON_OBJ) $(GRAVITY_OBJ) $(EOS_OBJ) $(BOUNDCOND_OBJ) $(STREAMLINES_OBJ) $(FIXED_POINT_OBJ) $(PARTICLES_CDATA_OBJ)
else
  $(INITIAL_CONDITION_OBJ): initial_condition.h $(INITIAL_CONDITION_SRC) initial_condition_dummies.inc $(COMMON_DEPS) $(FARRAY_OBJ) $(GENERAL_OBJ) $(POISSON_OBJ) $(GRAVITY_OBJ) $(EOS_OBJ) $(BOUNDCOND_OBJ) $(STREAMLINES_OBJ) $(FIXED_POINT_OBJ)
endif
#
$(TIMESTEP_OBJ): $(TIMESTEP_SRC) $(BORDER_PROFILES_OBJ) $(BOUNDCOND_OBJ) $(CDATA_OBJ) $(EQU_OBJ) $(FORCING_OBJ) $(MESSAGES_OBJ) $(MPICOMM_OBJ) $(PARTICLES_MAIN_OBJ) $(SUB_OBJ) $(SOLID_CELLS_OBJ) $(SPECIAL_OBJ)
#
$(SNAPSHOT_OBJ): $(SNAPSHOT_SRC) $(BOUNDCOND_OBJ) $(CDATA_OBJ) $(EOS_OBJ) $(MESSAGES_OBJ) $(MPICOMM_OBJ) $(GPU_OBJ) $(IO_OBJ) $(PARTICLES_MAIN_OBJ) $(PERSIST_OBJ) $(POWER_OBJ) $(PSCALAR_OBJ) $(RADIATION_OBJ) $(SHOCK_OBJ) $(STRUCT_FUNC_OBJ) $(CHEMISTRY_OBJ)
#
$(MESSAGES_OBJ): $(MESSAGES_SRC) $(CDATA_OBJ) $(GENERAL_OBJ) $(MPICOMM_OBJ) $(SYSCALLS_OBJ)
#
$(GEOMETRICAL_TYPES_OBJ): $(GEOMETRICAL_TYPES_SRC) $(CPARAM_OBJ)
#
ifneq ($(GHOSTFOLD),noghostfold)
$(GHOSTFOLD_OBJ): $(GHOSTFOLD_SRC) $(CDATA_OBJ) $(MPICOMM_OBJ) $(MESSAGES_OBJ) $(FOURIER_OBJ) $(SUB_OBJ)
endif
#
$(PERSIST_OBJ): $(PERSIST_SRC) $(IO_OBJ) $(CDATA_OBJ) $(GENERAL_OBJ) $(MAGNETIC_OBJ) $(INTERSTELLAR_OBJ) $(FORCING_OBJ) $(HYDRO_OBJ) $(SPECIAL_OBJ)
#
ifneq ($(PYTHON),nopython)
$(PYTHON_OBJ): python.h $(PYTHON_SRC) $(GENERAL_OBJ) $(SYSCALLS_OBJ)
endif
#
$(FILTER_OBJ): $(FILTER_SRC) $(CDATA_OBJ) $(SUB_OBJ) $(BOUNDCOND_OBJ) $(MPICOMM_OBJ)
#
# Explicit dependencies for the different physics modules.
#
$(MPICOMM_OBJ): mpicomm.h $(MPICOMM_SRC) $(CDATA_OBJ) $(GENERAL_OBJ) $(SYSCALLS_OBJ) $(YINYANG_OBJ)
#
$(NOMPICOMM_OBJ): mpicomm.h $(NOMPICOMM_SRC) $(CDATA_OBJ) $(GENERAL_OBJ) quiet.o 
#
$(GHOST_CHECK_OBJ): ghost_check.h $(GHOST_CHECK_SRC) $(MPICOMM_OBJ) $(CDATA_OBJ) $(CPARAM_OBJ)
#
ifneq ($(VISCOSITY),noviscosity)
$(VISCOSITY_OBJ): viscosity.h $(VISCOSITY_SRC) $(BOUNDCOND_OBJ) $(CDATA_OBJ) $(CPARAM_OBJ) $(SUB_OBJ) $(IMPLICIT_DIFFUSION_OBJ) $(INTERSTELLAR_OBJ)
else
$(VISCOSITY_OBJ): viscosity.h $(VISCOSITY_SRC) $(CDATA_OBJ) $(MESSAGES_OBJ) quiet.o
endif
#
ifneq ($(SHEAR),noshear)
$(SHEAR_OBJ): shear.h $(SHEAR_SRC) $(CDATA_OBJ) $(CPARAM_OBJ) $(DERIV_OBJ) $(DIAGNOSTICS_OBJ) $(FOURIER_OBJ) $(GENERAL_OBJ) $(MESSAGES_OBJ) $(MPICOMM_OBJ) $(SHARED_VARIABLES_OBJ) $(SUB_OBJ)
else
$(SHEAR_OBJ): shear.h $(SHEAR_SRC) $(MESSAGES_OBJ) quiet.o
endif
#
ifneq ($(GRAVITY),nogravity)
$(GRAVITY_OBJ): gravity.h $(GRAVITY_SRC) $(COMMON_DEPS) $(SHARED_VARIABLES_OBJ)
else
$(GRAVITY_OBJ): gravity.h $(GRAVITY_SRC) $(MESSAGES_OBJ) quiet.o $(SYSCALLS_OBJ)
endif
#
ifneq ($(SELFGRAVITY),noselfgravity)
$(SELFGRAVITY_OBJ): selfgravity.h $(SELFGRAVITY_SRC) $(CDATA_OBJ) $(SUB_OBJ) $(POISSON_OBJ) $(PARTICLES_MAIN_OBJ) $(SHARED_VARIABLES_OBJ) $(EOS_OBJ)
else
$(SELFGRAVITY_OBJ): selfgravity.h $(SELFGRAVITY_SRC) $(FILE_IO_OBJ) $(MESSAGES_OBJ) quiet.o $(SHARED_VARIABLES_OBJ)
endif
#
ifneq ($(POISSON),nopoisson)
$(POISSON_OBJ): poisson.h $(POISSON_SRC) $(CDATA_OBJ) $(FOURIER_OBJ) $(SUB_OBJ)
else
$(POISSON_OBJ): poisson.h $(POISSON_SRC) $(MESSAGES_OBJ) quiet.o
endif
#
ifneq ($(FORCING),noforcing)
$(FORCING_OBJ): forcing.h $(FORCING_SRC) $(DENSITY_OBJ) $(DENSITY_METHODS_OBJ) $(VISCOSITY_OBJ) $(COMMON_DEPS) $(IO_OBJ) $(EOS_OBJ) $(GSL_OBJ) $(MESSAGES_OBJ) $(SUB_OBJ) $(SYSCALLS_OBJ)
endif
#
ifneq ($(ENERGY),noentropy)
$(ENERGY_OBJ): energy.h energy_dummies.inc $(ENERGY_SRC) $(COMMON_DEPS) $(INITCOND_OBJ) $(INITIAL_CONDITION_OBJ) $(FARRAY_OBJ) $(FILE_IO_OBJ) $(BORDER_PROFILES_OBJ) $(SPECIAL_OBJ) $(EOS_OBJ) $(VISCOSITY_OBJ) $(INTERSTELLAR_OBJ) $(WENO_TRANSPORT_OBJ) $(DENSITY_OBJ) $(DENSITY_METHODS_OBJ) $(SLICES_METHODS_OBJ)
else
$(ENERGY_OBJ): energy.h $(ENERGY_SRC) $(CDATA) $(DIAGNOSTICS_OBJ) $(EOS_OBJ) $(MESSAGES_OBJ) $(SHARED_VARIABLES_OBJ) $(SYSCALLS_OBJ) quiet.o
endif
# $(CONDUCTIVITY_OBJ)
#
ifneq ($(OPACITY),noopacity)
$(OPACITY_OBJ): opacity.h $(OPACITY_SRC) $(COMMON_DEPS) $(MESSAGES_OBJ)
endif
#
ifneq ($(DETONATE),nodetonate)
$(DETONATE_OBJ): $(DETONATE_SRC) $(BOUNDCOND_OBJ) $(CDATA_OBJ) $(CPARAM_OBJ) $(DIAGNOSTICS_OBJ) $(EOS_OBJ) $(FARRAY_OBJ) $(GENERAL_OBJ) $(MESSAGES_OBJ) $(MPICOMM_OBJ) $(SHARED_VARIABLES_OBJ) $(SUB_OBJ)
endif
#
ifneq ($(MAGNETIC),nomagnetic)
$(MAGNETIC_OBJ): magnetic.h $(MAGNETIC_SRC) $(MAGNETIC_MEANFIELD_OBJ) $(INITIAL_CONDITION_OBJ) $(BOUNDCOND_OBJ) $(GRID_OBJ) $(FORCING_OBJ) $(YINYANG_MPI_OBJ) $(FILE_IO_OBJ) $(SLICES_METHODS_OBJ)
else
$(MAGNETIC_OBJ): magnetic.h $(MAGNETIC_SRC) $(CDATA_OBJ) $(MESSAGES_OBJ) $(SHARED_VARIABLES_OBJ) $(SYSCALLS_OBJ) quiet.o
endif
#
ifneq ($(MAGNETIC_MEANFIELD),magnetic/nomeanfield)
$(MAGNETIC_MEANFIELD_OBJ): ./magnetic/meanfield.h $(MAGNETIC_MEANFIELD_SRC) $(COMMON_DEPS) $(GRAVITY_OBJ) $(MAGNETIC_MEANFIELD_DEMFDT_OBJ)
else
$(MAGNETIC_MEANFIELD_OBJ): ./magnetic/meanfield.h $(MAGNETIC_MEANFIELD_SRC) $(CDATA_OBJ) $(SYSCALLS_OBJ) quiet.o
endif
#
ifneq ($(MAGNETIC_MEANFIELD_DEMFDT),magnetic/nomeanfield_demfdt)
$(MAGNETIC_MEANFIELD_DEMFDT_OBJ): ./magnetic/meanfield_demfdt.h $(MAGNETIC_MEANFIELD_DEMFDT_SRC) $(COMMON_DEPS)
endif
#
ifneq ($(DENSITY_METHODS),nodensity_methods)
$(DENSITY_METHODS_OBJ): density_methods.h $(DENSITY_METHODS_SRC) $(SHARED_VARIABLES_OBJ) $(COMMON_DEPS)
else
$(DENSITY_METHODS_OBJ): density_methods.h $(DENSITY_METHODS_SRC) $(MESSAGES_OBJ) $(SHARED_VARIABLES_OBJ) quiet.o
endif
#
$(DENSITY_OBJ): density.h $(DENSITY_SRC) $(COMMON_DEPS) $(BOUNDCOND_OBJ) $(POISSON_OBJ) $(INITCOND_OBJ) $(INITIAL_CONDITION_OBJ) $(FARRAY_OBJ) $(FILE_IO_OBJ) $(BORDER_PROFILES_OBJ) $(SPECIAL_OBJ) $(GRAVITY_OBJ) $(DEBUG_IO_OBJ) $(EOS_OBJ) $(SHARED_VARIABLES_OBJ) $(SLICES_METHODS_OBJ) $(WENO_TRANSPORT_OBJ) $(DENSITY_METHODS_OBJ)
#
ifneq ($(HEATFLUX),noheatflux)
$(HEATFLUX_OBJ): heatflux.h $(COMMON_DEPS) $(EOS_OBJ) $(SLICES_METHODS_OBJ)
endif
#
#$(HYDRO_OBJ): hydro.h hydro_omp.inc $(HYDRO_SRC) $(COMMON_DEPS) $(INITCOND_OBJ) $(INITIAL_CONDITION_OBJ) $(BOUNDCOND_OBJ) $(FARRAY_OBJ) $(BORDER_PROFILES_OBJ) $(VISCOSITY_OBJ) $(SLICES_METHODS_OBJ) $(SPECIAL_OBJ) $(GRAVITY_OBJ) $(MAGNETIC_OBJ) $(WENO_TRANSPORT_OBJ) $(DENSITY_OBJ) $(DENSITY_METHODS_OBJ) $(POISSON_OBJ) $(SGSHYDRO_OBJ)
$(HYDRO_OBJ): hydro.h $(HYDRO_SRC) $(COMMON_DEPS) $(INITCOND_OBJ) $(INITIAL_CONDITION_OBJ) $(BOUNDCOND_OBJ) $(FARRAY_OBJ) $(FORCING_OBJ) $(BORDER_PROFILES_OBJ) $(VISCOSITY_OBJ) $(SLICES_METHODS_OBJ) $(SPECIAL_OBJ) $(GRAVITY_OBJ) $(MAGNETIC_OBJ) $(COSMICRAY_OBJ) $(WENO_TRANSPORT_OBJ) $(DENSITY_OBJ) $(DENSITY_METHODS_OBJ) $(POISSON_OBJ) $(SGSHYDRO_OBJ) $(TRAINING_OBJ)
#
ifneq ($(RADIATION),noradiation)
$(RADIATION_OBJ): radiation.h $(RADIATION_SRC) $(COMMON_DEPS) $(GPU_OBJ) $(INITCOND_OBJ) $(INITIAL_CONDITION_OBJ) $(EOS_OBJ) $(SLICES_METHODS_OBJ) $(SYSCALLS_OBJ)
endif
#
ifneq ($(COSMICRAY),nocosmicray)
$(COSMICRAY_OBJ): cosmicray.h $(COSMICRAY_SRC) $(COMMON_DEPS) $(INITCOND_OBJ) $(INITIAL_CONDITION_OBJ) $(SLICES_METHODS_OBJ)
else
$(COSMICRAY_OBJ): cosmicray.h $(COSMICRAY_SRC) quiet.o $(MESSAGES_OBJ)
endif
#
#$(CONDUCTIVITY_OBJ): ./experimental/conductivity.h $(CONDUCTIVITY_SRC) $(COMMON_DEPS) $(EOS_OBJ) $(INITIAL_CONDITION_OBJ) $(SPECIAL_OBJ)
#
ifneq ($(COSMICRAYFLUX),nocosmicrayflux)
$(COSMICRAYFLUX_OBJ): cosmicrayflux.h $(COSMICRAYFLUX_SRC) $(COMMON_DEPS) $(DEBUG_IO_OBJ) $(INITCOND_OBJ) $(COSMICRAY_OBJ) $(SLICES_METHODS_OBJ) $(INITIAL_CONDITION_OBJ)
endif
#
ifneq ($(PSCALAR),noascalar)
$(PSCALAR_OBJ): pscalar.h $(PSCALAR_SRC) $(COMMON_DEPS) $(INITCOND_OBJ) $(INITIAL_CONDITION_OBJ) $(SPECIAL_OBJ) $(SLICES_METHODS_OBJ) $(CHEMISTRY_OBJ)
endif
#
ifneq ($(ASCALAR),noascalar)
$(ASCALAR_OBJ): ascalar.h $(ASCALAR_SRC) $(COMMON_DEPS) $(INITCOND_OBJ) $(INITIAL_CONDITION_OBJ)
endif
#
ifneq ($(CHIRAL),nochiral)
$(CHIRAL_OBJ): chiral.h $(CHIRAL_SRC) $(COMMON_DEPS) $(INITCOND_OBJ) $(INITIAL_CONDITION_OBJ) $(FARRAY_OBJ) $(SLICES_METHODS_OBJ)
endif
#
ifneq ($(CHEMISTRY), nochemistry)
$(CHEMISTRY_OBJ): chemistry.h $(CHEMISTRY_SRC) $(COMMON_DEPS) $(INITCOND_OBJ) $(INITIAL_CONDITION_OBJ) $(GENERAL_OBJ) $(EOS_OBJ) $(FARRAY_OBJ) $(SLICES_METHODS_OBJ) $(SPECIAL_OBJ) $(DERIV_OBJ)
else
$(CHEMISTRY_OBJ): chemistry.h $(CHEMISTRY_SRC) $(MESSAGES_OBJ) quiet.o syscalls.o
endif
#
ifneq ($(DUSTVELOCITY),nodustvelocity)
$(DUSTVELOCITY_OBJ): dustvelocity.h $(DUSTVELOCITY_SRC) $(COMMON_DEPS) $(INITCOND_OBJ) $(INITIAL_CONDITION_OBJ) $(GENERAL_OBJ) $(DENSITY_OBJ) $(EOS_OBJ) $(PSCALAR_OBJ) $(GRAVITY_OBJ) $(BORDER_PROFILES_OBJ) $(SLICES_METHODS_OBJ)
else
$(DUSTVELOCITY_OBJ): dustvelocity.h $(DUSTVELOCITY_SRC) $(CDATA_OBJ) $(FILE_IO_OBJ) quiet.o $(MESSAGES_OBJ) $(SHARED_VARIABLES_OBJ)
endif
#
ifneq ($(DUSTDENSITY),nodustdensity)
$(DUSTDENSITY_OBJ): dustdensity.h $(DUSTDENSITY_SRC) $(COMMON_DEPS) $(MPICOMM_OBJ) $(SHARED_VARIABLES_OBJ) $(INITCOND_OBJ) $(INITIAL_CONDITION_OBJ) $(SHOCK_OBJ) $(DUSTVELOCITY_OBJ) $(BORDER_PROFILES_OBJ) $(SLICES_METHODS_OBJ) $(CHEMISTRY_OBJ)
endif
#
ifneq ($(NEUTRALDENSITY),noneutraldensity)
$(NEUTRALDENSITY_OBJ): neutraldensity.h $(NEUTRALDENSITY_SRC) $(COMMON_DEPS) $(INITCOND_OBJ) $(INITIAL_CONDITION_OBJ) $(BORDER_PROFILES_OBJ)
endif
#
ifneq ($(NEUTRALVELOCITY),noneutralvelocity)
$(NEUTRALVELOCITY_OBJ): neutralvelocity.h $(NEUTRALVELOCITY_SRC) $(COMMON_DEPS) $(INITCOND_OBJ) $(INITIAL_CONDITION_OBJ) $(GENERAL_OBJ) $(GRAVITY_OBJ) $(NEUTRALDENSITY_OBJ) $(BORDER_PROFILES_OBJ)
else
$(NEUTRALVELOCITY_OBJ): neutralvelocity.h $(NEUTRALVELOCITY_SRC) $(MESSAGES_OBJ) quiet.o
endif
#
ifneq ($(TESTPERTURB),notestperturb)
testperturb.o: testperturb.h $(TESTPERTURB_SRC) $(COMMON_DEPS) $(TIMESTEP_OBJ) $(HYDRO_OBJ) $(EQU_OBJ)
endif
#
ifneq ($(TESTSCALAR),notestscalar)
$(TESTSCALAR_OBJ): testscalar.h $(TESTSCALAR_SRC) $(COMMON_DEPS) $(INITCOND_OBJ) $(INITIAL_CONDITION_OBJ) $(DEBUG_IO_OBJ) $(HYDRO_OBJ)
endif
#
$(TESTFIELD_GENERAL_OBJ): $(TESTFIELD_GENERAL_SRC) $(COMMON_DEPS) $(INITCOND_OBJ) $(INITIAL_CONDITION_OBJ) $(DEBUG_IO_OBJ) $(HYDRO_OBJ) $(MAGNETIC_OBJ)
#
ifneq ($(TESTFIELD),notestfield)
$(TESTFIELD_OBJ): testfield.h $(TESTFIELD_SRC) $(COMMON_DEPS) $(INITCOND_OBJ) $(INITIAL_CONDITION_OBJ) $(DEBUG_IO_OBJ) $(HYDRO_OBJ) $(MAGNETIC_OBJ) $(TESTFIELD_GENERAL_OBJ)
endif
#
ifneq ($(TESTFLOW),notestflow)
$(TESTFLOW_OBJ): testflow.h $(TESTFLOW_SRC) $(COMMON_DEPS) $(INITCOND_OBJ) $(INITIAL_CONDITION_OBJ) $(HYDRO_OBJ) $(FARRAY_OBJ) $(FORCING_OBJ)
endif
#
ifneq ($(INTERSTELLAR),nointerstellar)
$(INTERSTELLAR_OBJ): interstellar.h $(INTERSTELLAR_SRC) $(COMMON_DEPS) $(EOS_OBJ) $(GPU_OBJ) $(GRID_OBJ) $(IO_OBJ) $(SLICES_METHODS_OBJ) $(SYSCALLS_OBJ)
endif
#
ifneq ($(HYPERVISC_STRICT),nohypervisc_strict)
$(HYPERVISC_STRICT_OBJ): hypervisc_strict.h $(HYPERVISC_STRICT_SRC) $(CDATA_OBJ) $(CPARAM_OBJ) $(FOURIER_OBJ)
endif
#
ifneq ($(HYPERRESI_STRICT),nohyperresi_strict)
$(HYPERRESI_STRICT_OBJ): hyperresi_strict.h $(HYPERRESI_STRICT_SRC) $(CDATA_OBJ) $(CPARAM_OBJ) $(FOURIER_OBJ)
endif
#
$(EOS_OBJ): eos.h eos_dummies.inc $(EOS_SRC) $(COMMON_DEPS) $(DENSITY_METHODS_OBJ) $(DERIV_OBJ) $(FARRAY_OBJ) $(GRAVITY_OBJ) $(FOURIER_OBJ) $(SHARED_VARIABLES_OBJ) $(SLICES_METHODS_OBJ)
#
nofourier.o: $(FOURIER_SRC) fourier_common.h fourier.h quiet.o $(MESSAGES_OBJ)
#
fourier_fft.o: $(FOURIER_SRC) fourier_common.h fourier.h fft.o $(GENERAL_OBJ) $(SUB_OBJ) $(MESSAGES_OBJ) $(MPICOMM_OBJ) $(CPARAM_OBJ) $(CDATA_OBJ)
#
fourier_fftpack.o: $(FOURIER_SRC) fourier_common.h fourier.h fftpack.o $(GENERAL_OBJ) $(SUB_OBJ) $(MESSAGES_OBJ) $(MPICOMM).o $(CPARAM_OBJ) $(CDATA_OBJ)
#
$(DEBUG_IO_OBJ): io.h $(DEBUG_IO_SRC) $(CDATA_OBJ) $(MPICOMM_OBJ) $(MESSAGES_OBJ)
#
$(HDF5_IO_OBJ): hdf5_io.h $(HDF5_IO_SRC) $(CDATA_OBJ) $(CPARAM_OBJ) $(FILE_IO_OBJ) $(GEOMETRICAL_TYPES_OBJ) $(GENERAL_OBJ) $(MESSAGES_OBJ) $(MPICOMM_OBJ) $(SLICES_METHODS_OBJ)
#
$(IO_IN_OBJ) $(IO_OUT_OBJ) $(IO_OBJ): io.h io_common.inc $(IO_SRC) $(CDATA_OBJ) $(CPARAM_OBJ) $(FARRAY_OBJ) $(FILE_IO_OBJ) $(GENERAL_OBJ) $(GEOMETRICAL_TYPES_OBJ) $(HDF5_IO_OBJ) $(MESSAGES_OBJ) $(MPICOMM_OBJ) $(PARTICLES_CDATA_OBJ) $(SUB_OBJ) $(SYSCALLS_OBJ)
ifeq ($(IO),io_wrapper)
  $(IO_OBJ): $(IO_IN_OBJ) $(IO_OUT_OBJ)
endif
#
ifneq ($(TIMEAVG),noteimeavg)
$(TIMEAVG_OBJ): timeavg.h $(TIMEAVG_SRC) $(COMMON_DEPS) $(DEBUG_IO_OBJ) $(IO_OBJ)
endif
#
ifneq ($(POWER),nopower_spectrum)
$(POWER_OBJ): power_spectrum.h $(POWER_SRC) $(COMMON_DEPS) $(GENERAL_OBJ) $(MAGNETIC_OBJ) $(CHIRAL_OBJ) $(FOURIER_OBJ) $(SPECIAL_OBJ)
endif
#
ifneq ($(STRUCT_FUNC),nostruct_func)
$(STRUCT_FUNC_OBJ): struct_func.h $(STRUCT_FUNC_SRC) $(COMMON_DEPS) $(GENERAL_OBJ)
else
$(STRUCT_FUNC_OBJ): struct_func.h $(STRUCT_FUNC_SRC) cdata.o quiet.o
endif
#
$(SPECIAL_OBJ): special.h $(COMMON_DEPS) $(SYSCALLS_OBJ) $(GPU_OBJ) $(FILE_IO_OBJ)
ifeq ($(SPECIAL),special/NS_polecap)
  physics += special/potekhin_cond.o
  $(SPECIAL_OBJ): $(SPECIAL_SRC) special_dummies.inc $(EOS_OBJ) $(INITCOND_OBJ) $(DEBUG_IO_OBJ) $(GRID_OBJ) $(PARTICLES_CDATA_OBJ) $(SLICES_METHODS_OBJ) special/potekhin_cond.o
else ifeq ($(SPECIAL),special/meanfield_e_tensor)
  #polynomialroots.o: polynomialroots.f90
  technical +=  polynomialroots.o
  technical_nompi +=  polynomialroots.o
  $(SPECIAL_OBJ): $(SPECIAL_SRC) special_dummies.inc $(EOS_OBJ) $(INITCOND_OBJ) $(DEBUG_IO_OBJ) $(GRID_OBJ) $(PARTICLES_CDATA_OBJ) $(SLICES_METHODS_OBJ) polynomialroots.o
else ifeq ($(SPECIAL),nospecial)
  $(SPECIAL_OBJ): $(NOSPECIAL_SRC) quiet.o
else ifeq ($(filter-out pressure_bump,$(SPECIAL_OBJ)),)
  $(SPECIAL_OBJ): $(SPECIAL_SRC) special_dummies.inc $(EOS_OBJ) $(DENSITY_OBJ) $(FILE_IO_OBJ) $(SLICES_METHODS_OBJ)
else ifeq ($(filter-out atmosphere chem_stream internal_flow jet,$(SPECIAL_OBJ)),)
  $(SPECIAL_OBJ): $(SPECIAL_SRC) special_dummies.inc $(EOS_OBJ) $(INITCOND_OBJ) $(DEBUG_IO_OBJ) $(GRID_OBJ) $(SLICES_METHODS_OBJ)
else ifeq ($(shell grep -i '^ *use  *particles_cdata' $(SPECIAL_SRC)),)
  $(SPECIAL_OBJ): $(SPECIAL_SRC) special_dummies.inc $(EOS_OBJ) $(INITCOND_OBJ) $(DEBUG_IO_OBJ) $(GRID_OBJ) $(PARTICLES_CDATA_OBJ) $(SLICES_METHODS_OBJ)
else
  $(SPECIAL_OBJ): $(SPECIAL_SRC) special_dummies.inc $(EOS_OBJ) $(INITCOND_OBJ) $(DEBUG_IO_OBJ) $(GRID_OBJ) $(SLICES_METHODS_OBJ) $(SHARED_VARIABLES_OBJ)
endif
ifneq ($(shell grep -i '^ *use  *particles_sub' $(SPECIAL_SRC)),)
  $(SPECIAL_OBJ): $(SPECIAL_SRC) special_dummies.inc $(EOS_OBJ) $(INITCOND_OBJ) $(DEBUG_IO_OBJ) $(GRID_OBJ) $(PARTICLES_SUB_OBJ) $(SLICES_METHODS_OBJ)
endif
$(SPECIAL_MODULES:=.o): special.h $(SPECIAL_MODULES:=.f90) special_dummies.inc $(COMMON_DEPS) $(EOS_OBJ) $(INITCOND_OBJ) $(DEBUG_IO_OBJ) $(GRID_OBJ) $(SLICES_METHODS_OBJ)
