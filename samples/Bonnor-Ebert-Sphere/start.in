!  -*-f90-*-  (for Emacs)    vim:set filetype=fortran:  (for vim)
!
! Initialisation parameters for shocktube problem
!
&init_pars
  cvsid='$Id: start.in,v 1.1 2026/07/27 06:55:39 brandenb Exp $'
  xyz0  = -0.62831853, -0.62831853, -0.62831853   ! first corner of box
  xyz1  =  0.62831853,  0.62831853,  0.62831853   ! last corner of box
  lperi =     T,     T,     T   ! periodic direction?
!  lwrite_ic=T, lwrite_aux=T
/
&eos_init_pars
  gamma=1.6667, rho0=1.0, cs0=1.0
/
&hydro_init_pars
  inituu='power_randomphase_hel',
  ampluu=0.2,  relhel_uu=0.0, qirro_uu=1.
  initpower=-1.6667, initpower2=4, 
  cutoff=50., ncutoff=2.
  kpeak=5.
/
&density_init_pars
/
&selfgrav_init_pars
  rhs_poisson_const=1.0
/
&poisson_init_pars
/
&initial_condition_pars
   rhoc=1.0, xmax=6.2831853
/
