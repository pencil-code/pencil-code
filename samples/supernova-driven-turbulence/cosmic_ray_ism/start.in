!  -*-f90-*-  (for Emacs)    vim:set filetype=fortran:  (for vim)
!
! Initialisation parameters for interstellar
!
&init_pars
  cvsid="8cc7b1488"
  unit_length=3.08567758e21, unit_velocity=9.778122994895071e4
  unit_density=1.6737236e-24
  xyz0=-0.032,-0.032,-0.398
  xyz1=+0.032,+0.032,+0.398
  lperi=T,T,F
  bcz = 's','s','s','s','s','s','s','s','s','s','s','s','cop'
  !bcz = 's','s','s','s','s','s','s','s','cop'
  lwrite_aux=T
  lfix_unit_std=T
/
&initial_condition_pars
  initaa='uniform-x','gaussian-noise'
  inituu='nothing'
  amplaa=1e-4,1e-8
/
&eos_init_pars
  mu=0.531
/
&hydro_init_pars
  inituu='gaussian-noise'
  ampluu=1e-1
  Omega=25.0
/
&density_init_pars
  initlnrho='nothing'
  ldensity_nolog=T
/
&grav_init_pars
  gravz_profile='Ferriere'
/
&entropy_init_pars
  initss='nothing'
/
&interstellar_init_pars
  initinterstellar='multiple'
  initial_SNI = 1
  lSNII=T
  lSNI=T
  lSN_ecr=T
  lSN_fcr=F
  frac_ecr=0.03
  lSN_scale_rad=T
  ltrim_profile=T
  N_mass=75.0
  rfactor_SN=1.5
  lSN_autofrackin=F
/
&shear_init_pars
  qshear=1.0
/
&cosmicray_init_pars
  K_para=100
  K_perp=10
  cosmicray_diff=0.04
  initecr='gaussian-noise'
  amplecr=1e-7
/
&cosmicrayflux_init_pars
  tau=0.01
/
&magnetic_init_pars
  initaa='nothing'
/
