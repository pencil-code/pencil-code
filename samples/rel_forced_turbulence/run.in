!  -*-f90-*-  (for Emacs)    vim:set filetype=fortran:  (for vim)
!
! Runtime parameters for relativistic forced turbulence sample
!
&run_pars
  cvsid="ccf8f11ca"
  nt=200, it1=10, cdt=0.8, cdtv=0.1, itorder=3
  !nt=3200
  dspec=0.1, ou_spec=T
  lpencil_check_small=F
  test_nonblocking=T
  tmax=2.
/
&eos_run_pars
/
&hydro_run_pars
  max_vel=0.999
/
&density_run_pars
  idiff='normal', diffrho=0.5
  lmassdiff_fix=F
/
&forcing_run_pars
  iforce='helical', force=3.0, relhel=0.
  lforce_always_all_compomemts=T
/
/
&viscosity_run_pars
  ivisc='simplified', nu=0.5
/
&power_spectrum_run_pars
/
