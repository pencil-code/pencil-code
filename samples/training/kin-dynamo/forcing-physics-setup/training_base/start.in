!  -*-f90-*-  (for Emacs)    vim:set filetype=fortran:  (for vim)
!
! Initialisation parameters for a kinematic dynamo run
!
&init_pars
  cvsid='$Id$',
  random_gen='nr_f90'
  lwrite_aux=T
  lkinflow_as_aux=T
/
&hydro_init_pars
/
&magnetic_init_pars
  initaa='gaussian-noise', amplaa=1e-4
/
&eos_init_pars
  gamma=1.
/
&density_init_pars
  initlnrho='const_rho'
  ldensity_nolog=T
/
